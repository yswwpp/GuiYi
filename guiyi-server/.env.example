# GuiYi 配置文件模板
# 复制此文件为 .env 并填写配置

# API 配置
API_HOST=127.0.0.1
API_PORT=8765
API_DEBUG=true

# 数据库配置
DATABASE_URL=sqlite:///data/sync_metadata.sqlite

# Obsidian 配置
OBSIDIAN_VAULT_PATH=data/obsidian_vault

# 索引配置
INDEX_PATH=data/index

# 飞书配置（可选）
FEISHU_COMPANY_APP_ID=
FEISHU_COMPANY_APP_SECRET=
FEISHU_PERSONAL_APP_ID=
FEISHU_PERSONAL_APP_SECRET=

# 印象笔记配置（可选）
YINXIANG_DEV_TOKEN=

# 夸克网盘配置（可选）
QUARK_COOKIE=

# WPS 配置（可选）
WPS_WATCH_DIRS=[]

# 同步配置
SYNC_INTERVAL_HOURS=24
